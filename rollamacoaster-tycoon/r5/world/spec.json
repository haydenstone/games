{
  "specVersion": 3,
  "runtimePrimitive": "world-runtime-v3-simclock",
  "release": "R5.0-dev.7",
  "entities": {
    "ava": {"kind":"observer","name":"Ava","memoryLimit":100,"initialHappiness":55,"initialWisdom":0},
    "codex": {"kind":"externalKnowledge","mount":"/codex/codex.json"},
    "clock": {"kind":"simulationClock","stepMs":100,"timelineDelta":0.006,"persistent":true}
  },
  "relationships": [{"from":"ava","type":"can-perceive","to":"codex"}],
  "rules": [
    {"when":"simulation tick && ava can-perceive codex","effect":"ava perceives iteration verse; wisdom +0.12; happiness +0.08"},
    {"when":"simulation tick && !(ava can-perceive codex)","effect":"perception absent; happiness -0.06"},
    {"when":"simulation stopped","effect":"no simulated state transitions"},
    {"when":"process starts","effect":"restore world state without changing simulation running state"}
  ]
}
